---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import CapsuleCard from "../components/CapsuleCard.astro";
import capsulesData from "../content/capsules.json";

interface RichText {
  type?: string;
  text?: string;
  href?: string;
  annotations?: {
    bold?: boolean;
    italic?: boolean;
    strikethrough?: boolean;
    underline?: boolean;
    code?: boolean;
  };
}

interface CapsuleBlock {
  type?: string;
  text?: string;
  url?: string;
  href?: string;
  caption?: string;
  alt?: string;
  children?: RichText[];
  rich_text?: RichText[];
}

interface Capsule {
  id?: string;
  date?: string;
  tags?: string[];
  tag?: string | string[];
  blocks?: CapsuleBlock[];
}

const capsules = (capsulesData as Capsule[])
  .filter((capsule) => capsule && capsule.date)
  .sort((a, b) => {
    const dateA = new Date(a.date || 0).getTime();
    const dateB = new Date(b.date || 0).getTime();

    return dateB - dateA;
  });

const pageSize = 20;
const initialCapsules = capsules.slice(0, pageSize);
const hasMore = capsules.length > pageSize;
---

<MainGridLayout
  description="即时想法、吐槽和日常"
>
  <div class="mx-auto min-w-0 w-full max-w-3xl px-4 pb-16 pt-8">
    <header class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Twitter</h1>

      <p class="text-black/55 dark:text-white/55">
        即时想法、吐槽和日常
      </p>
    </header>

    {
      capsules.length > 0 ? (
        <>
          <section
            id="capsule-feed"
            class="grid min-w-0 gap-4"
            aria-label="Twitter 信息流"
          >
            {initialCapsules.map((capsule) => (
              <CapsuleCard capsule={capsule} />
            ))}
          </section>

          {hasMore && (
            <div class="mt-8 flex justify-center">
              <button
                id="load-more-capsules"
                type="button"
                class="rounded-full border border-black/10 px-5 py-2.5 text-sm text-black/65 transition hover:bg-black/5 hover:text-black dark:border-white/10 dark:text-white/65 dark:hover:bg-white/5 dark:hover:text-white"
              >
                加载更多
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="rounded-2xl border border-black/10 p-8 text-center text-black/50 dark:border-white/10 dark:text-white/50">
          暂时还没有闪念内容。
        </div>
      )
    }
  </div>
</MainGridLayout>

<script define:vars={{ capsules, pageSize }}>
  const setupCapsuleFeed = () => {
    const feed = document.querySelector("#capsule-feed");
    const button = document.querySelector("#load-more-capsules");

    if (!feed || !button) return;

    if (button.dataset.initialized === "true") return;
    button.dataset.initialized = "true";

    let offset = pageSize;

    const escapeHtml = (value) => {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    };

    const formatDate = (value) => {
      if (!value) return "";

      const parsed = new Date(value);

      if (Number.isNaN(parsed.getTime())) {
        return String(value).replaceAll("-", ".");
      }

      return new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
        .format(parsed)
        .replaceAll("/", ".");
    };

    const getTags = (capsule) => {
      const tags = [
        ...(Array.isArray(capsule.tags) ? capsule.tags : []),
        ...(Array.isArray(capsule.tag)
          ? capsule.tag
          : capsule.tag
            ? [capsule.tag]
            : []),
      ].filter(Boolean);

      return [...new Set(tags)];
    };

    const renderText = (items = []) => {
      return items
        .map((item) => {
          let content = escapeHtml(item.text || "");
          const annotations = item.annotations || {};

          if (annotations.code) {
            content = `<code class="rounded bg-black/5 px-1 py-0.5 font-mono text-sm dark:bg-white/10">${content}</code>`;
          }

          if (annotations.bold) content = `<strong>${content}</strong>`;
          if (annotations.italic) content = `<em>${content}</em>`;
          if (annotations.strikethrough) content = `<s>${content}</s>`;
          if (annotations.underline) content = `<u>${content}</u>`;

          if (item.href) {
            content = `
              <a
                href="${escapeHtml(item.href)}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline max-w-full break-all text-[var(--primary)] underline decoration-[var(--primary)]/40 underline-offset-4"
              >
                ${content}
              </a>
            `;
          }

          return content;
        })
        .join("");
    };

    const renderBlock = (block) => {
      const type = block.type || "paragraph";
      const items = block.rich_text || block.children || [];

      const content = items.length
        ? renderText(items)
        : escapeHtml(block.text || "");

      if (type === "image" && block.url) {
        return `
          <figure class="mt-4 max-w-full overflow-hidden rounded-xl">
            <img
              src="${escapeHtml(block.url)}"
              alt="${escapeHtml(block.alt || block.caption || "")}"
              loading="lazy"
              class="block h-auto max-w-full"
            />
            ${
              block.caption
                ? `<figcaption class="mt-2 text-center text-sm text-black/40 dark:text-white/40">${escapeHtml(block.caption)}</figcaption>`
                : ""
            }
          </figure>
        `;
      }

      if (type === "divider") {
        return `<hr class="my-5 border-black/10 dark:border-white/10" />`;
      }

      if (type === "heading_1") {
        return `<h2 class="mt-5 mb-2 text-xl font-bold">${content}</h2>`;
      }

      if (type === "heading_2") {
        return `<h3 class="mt-4 mb-2 text-lg font-bold">${content}</h3>`;
      }

      if (type === "heading_3") {
        return `<h4 class="mt-4 mb-2 font-bold">${content}</h4>`;
      }

      if (type === "quote") {
        return `
          <blockquote class="my-4 max-w-full border-l-4 border-[var(--primary)]/40 pl-4 text-black/60 italic dark:text-white/60">
            ${content}
          </blockquote>
        `;
      }

      if (type === "bulleted_list_item") {
        return `<li class="ml-5 list-disc">${content}</li>`;
      }

      if (type === "numbered_list_item") {
        return `<li class="ml-5 list-decimal">${content}</li>`;
      }

      if (
        ["bookmark", "embed", "link_preview"].includes(type) &&
        (block.url || block.href)
      ) {
        const url = block.url || block.href || "";

        return `
          <a
            href="${escapeHtml(url)}"
            target="_blank"
            rel="noopener noreferrer"
            class="my-4 block max-w-full break-all rounded-xl border border-black/10 px-4 py-3 text-sm text-[var(--primary)] transition hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5"
          >
            ${escapeHtml(url)}
          </a>
        `;
      }

      return `<p class="mb-3 max-w-full last:mb-0">${content}</p>`;
    };

    const renderCapsule = (capsule) => {
      const tagList = getTags(capsule);

      const tagsHtml = tagList
        .map(
          (tag) =>
            `<span class="break-all text-[var(--primary)]">#${escapeHtml(tag)}</span>`,
        )
        .join("");

      const blocksHtml = (capsule.blocks || [])
        .map(renderBlock)
        .join("");

      const article = document.createElement("article");

      article.className =
        "capsule-card min-w-0 max-w-full rounded-xl border border-black/10 bg-white/70 p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03]";

      article.innerHTML = `
        <header class="mb-4 flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <time
            datetime="${escapeHtml(capsule.date || "")}"
            class="shrink-0 font-mono text-black/45 dark:text-white/45"
          >
            ${formatDate(capsule.date)}
          </time>

          ${
            tagsHtml
              ? `<div class="flex min-w-0 flex-wrap gap-x-3 gap-y-1">${tagsHtml}</div>`
              : ""
          }
        </header>

        <div class="capsule-content min-w-0 max-w-full break-words text-[1rem] leading-8 text-black/80 dark:text-white/80">
          ${blocksHtml}
        </div>
      `;

      return article;
    };

    const updateButton = () => {
      if (offset >= capsules.length) {
        button.textContent = "已经到底了";
        button.disabled = true;
        button.classList.add("cursor-default", "opacity-50");
      }
    };

    button.addEventListener("click", () => {
      const nextCapsules = capsules.slice(offset, offset + pageSize);

      if (nextCapsules.length === 0) {
        updateButton();
        return;
      }

      const fragment = document.createDocumentFragment();

      nextCapsules.forEach((capsule) => {
        fragment.appendChild(renderCapsule(capsule));
      });

      feed.appendChild(fragment);
      offset += nextCapsules.length;

      updateButton();
    });

    updateButton();
  };

  setupCapsuleFeed();
  document.addEventListener("astro:page-load", setupCapsuleFeed);
</script>

<style>
  #capsule-feed {
    min-width: 0;
  }

  .capsule-card {
    min-width: 0;
    max-width: 100%;
  }

  .capsule-card :global(.capsule-content),
  .capsule-content {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .capsule-content :global(*) {
    max-width: 100%;
  }

  .capsule-content :global(p),
  .capsule-content :global(li),
  .capsule-content :global(blockquote),
  .capsule-content :global(a),
  .capsule-content :global(code) {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .capsule-content :global(a) {
    white-space: normal;
  }

  .capsule-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .capsule-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
