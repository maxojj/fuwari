---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection("posts", ({ data }) => {
    return data.draft !== true;
  });
  
  const sortedPosts = allPosts.sort((a, b) => {
    const dateA = new Date(a.data.published || a.data.pubDate || 0).valueOf();
    const dateB = new Date(b.data.published || b.data.pubDate || 0).valueOf();
    return dateB - dateA;
  });

  return paginate(sortedPosts, { pageSize: 6 });
}

const { page } = Astro.props;

// 获取全部分类用于顶部展示
const allPosts = await getCollection("posts");
const categories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))];

const formatDate = (date: any) => {
  if (!date) return "";
  return new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-');
};
---

<MainGridLayout title="全部文章" hasSidebar={false}>
  <div class="max-w-[900px] mx-auto px-4 md:px-0">
    
    <!-- 顶部导航：分类过滤器 -->
    <div class="mb-12 animate-fade-up">
      <h1 class="text-4xl font-bold text-black/80 dark:text-white/90 mb-8 flex items-center gap-4">
        <span class="w-1.5 h-8 bg-[var(--primary)] rounded-full"></span>
        归档
      </h1>
      
      <div class="flex flex-wrap gap-2 text-sm">
        <a href="/blog" class="px-4 py-2 rounded-full bg-[var(--primary)] text-white shadow-lg shadow-[var(--primary)]/20 transition-all">
          全部文章
        </a>
        {categories.map(cat => (
          <a href={`/archive/category/${cat}`} class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 hover:bg-black/10 dark:hover:bg-white/10 transition-all">
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- 文章列表 -->
    <div class="grid gap-8">
      {page.data.map((post:any) => (
        <a href={`/posts/${post.slug}`} class="group relative block p-8 rounded-3xl bg-white/50 dark:bg-zinc-900/50 border border-black/5 dark:border-white/5 hover:border-[var(--primary)]/30 transition-all duration-500 hover:shadow-2xl hover:shadow-[var(--primary)]/5">
          <div class="flex flex-col gap-4">
            <div class="flex justify-between items-start">
              <h2 class="text-2xl font-bold text-black/80 dark:text-white/90 group-hover:text-[var(--primary)] transition-colors duration-300">
                {post.data.title}
              </h2>
              <time class="text-sm font-mono text-black/20 dark:text-white/20 mt-2">
                {formatDate(post.data.published || post.data.pubDate)}
              </time>
            </div>

            {post.data.tags && (
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag:string) => (
                  <span class="text-[11px] font-medium text-black/40 dark:text-white/40 px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 uppercase tracking-wider">
                    #{tag}
                  </span>
                ))}
              </div>
            )}

            <p class="text-black/50 dark:text-white/50 line-clamp-2 text-[15px] leading-relaxed">
              {post.data.description}
            </p>
          </div>
          
          <div class="mt-6 flex items-center text-[var(--primary)] text-sm font-bold opacity-0 group-hover:opacity-100 transition-all transform translate-x-[-10px] group-hover:translate-x-0">
            阅读全文 <svg class="ml-1 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </div>
        </a>
      ))}
    </div>

    <!-- 分页器 -->
    <nav class="flex justify-center items-center gap-8 mt-16 mb-20 font-mono text-sm">
      {page.url.prev ? (
        <a href={page.url.prev} class="p-3 rounded-full bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/5 hover:text-[var(--primary)] transition-all shadow-sm">
           <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </a>
      ) : <div class="w-11"></div>}

      <span class="text-black/30 dark:text-white/30 italic">
        {page.currentPage} <span class="mx-2">/</span> {page.lastPage}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class="p-3 rounded-full bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/5 hover:text-[var(--primary)] transition-all shadow-sm">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      ) : <div class="w-11"></div>}
    </nav>
  </div>
</MainGridLayout>

<style>
  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
