---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection("posts", ({ data }) => {
    return data.draft !== true;
  });
  
  const sortedPosts = allPosts.sort((a, b) => {
    const dateA = new Date(a.data.published || a.data.pubDate || 0).valueOf();
    const dateB = new Date(b.data.published || b.data.pubDate || 0).valueOf();
    return dateB - dateA;
  });

  return paginate(sortedPosts, { pageSize: 6 });
}

const { page } = Astro.props;

// 获取全部分类用于顶部展示
const allPosts = await getCollection("posts");
const categories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))];

const formatDate = (date: any) => {
  if (!date) return "";
  const d = new Date(date);
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-');
};
---

<MainGridLayout title="Blog" showSidebar={true} wide={false}>
  <div class="max-w-[850px] mx-auto px-4 md:px-0">
    
    <!-- 顶部导航 -->
    <div class="mb-8 animate-fade-up">
      <h1 class="text-3xl font-bold text-black/80 dark:text-white/90 mb-6 flex items-center gap-3">
        <span class="w-1.5 h-7 bg-[var(--primary)] rounded-full"></span>
        Blog
      </h1>
      
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/blog" class="px-3 py-1.5 rounded-lg bg-[var(--primary)] text-white shadow-md shadow-[var(--primary)]/10 transition-all">
          全部
        </a>
        {categories.map(cat => (
          <a href={`/archive/category/${cat}`} class="px-3 py-1.5 rounded-lg bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 hover:bg-black/10 dark:hover:bg-white/10 transition-all border border-transparent hover:border-black/5">
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- 文章列表 -->
    <div class="grid gap-4"> <!-- 减小了卡片之间的间距 -->
      {page.data.map((post: any) => {
        const hasImage = !!post.data.image;
        return (
          <a href={`/posts/${post.slug}`} class="group relative block rounded-2xl bg-white/40 dark:bg-zinc-900/40 border border-black/5 dark:border-white/5 hover:border-[var(--primary)]/30 transition-all duration-300 hover:shadow-xl hover:shadow-[var(--primary)]/5 overflow-hidden">
            <div class="flex flex-col md:flex-row">
              
              {hasImage && (
                <div class="md:w-52 h-40 md:h-auto overflow-hidden"> <!-- 减小了图片宽度 -->
                  <img 
                    src={post.data.image} 
                    alt={post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}

              <div class={`p-5 md:p-6 flex-1 flex flex-col justify-center`}> <!-- 减小了内边距 -->
                <div class="flex justify-between items-baseline mb-2">
                  <h2 class="text-xl font-bold text-black/80 dark:text-white/90 group-hover:text-[var(--primary)] transition-colors duration-300 line-clamp-1">
                    {post.data.title}
                  </h2>
                  <time class="text-[12px] font-mono text-black/20 dark:text-white/20 ml-4 flex-shrink-0">
                    {formatDate(post.data.published || post.data.pubDate)}
                  </time>
                </div>

                {post.data.tags && (
                  <div class="flex flex-wrap gap-2 mb-3">
                    {post.data.tags.map((tag: string) => (
                      <span class="text-[10px] font-medium text-black/30 dark:text-white/30 px-1.5 py-0.5 rounded bg-black/5 dark:bg-white/5 uppercase tracking-tight">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}

                <p class="text-black/40 dark:text-white/40 line-clamp-1 text-sm leading-relaxed">
                  {post.data.description}
                </p>
                
                <!-- 移除了原本底部的“阅读全文”按钮，改用更隐晦的悬停效果，使卡片更干净 -->
                <div class="absolute right-4 bottom-4 opacity-0 group-hover:opacity-100 transition-all translate-x-2 group-hover:translate-x-0 text-[var(--primary)]">
                   <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
              </div>
            </div>
          </a>
        )
      })}
    </div>

    <!-- 分页器 -->
    <nav class="flex justify-center items-center gap-6 mt-12 mb-20 font-mono text-xs">
      {page.url.prev ? (
        <a href={page.url.prev} class="p-2.5 rounded-xl bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/5 hover:text-[var(--primary)] transition-all">
           <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </a>
      ) : <div class="w-9"></div>}

      <span class="text-black/20 dark:text-white/20">
        {page.currentPage} <span class="mx-1">/</span> {page.lastPage}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class="p-2.5 rounded-xl bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/5 hover:text-[var(--primary)] transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      ) : <div class="w-9"></div>}
    </nav>
  </div>
</MainGridLayout>

<style>
  .animate-fade-up {
    animation: fade-up 0.5s ease-out forwards;
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
