---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import photosData from "../content/photos.json";

interface Photo {
  title: string;
  url: string;
  date: string;
}

const photos = (photosData || []) as Photo[];
---

<MainGridLayout title="相册">
    <div class="max-w-[1200px] mx-auto pb-10 px-4 md:px-0">
        <!-- 瀑布流布局 -->
        <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
            {photos.map((photo) => (
                <div class="break-inside-avoid group relative rounded-2xl overflow-hidden bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
                    <img 
                        src={photo.url} 
                        alt={photo.title}
                        loading="lazy"
                        class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                        <h3 class="text-white text-lg font-bold">{photo.title}</h3>
                        <p class="text-white/60 text-sm font-mono">{photo.date}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <script is:inline>
        function handleSidebar() {
            const isPhotoPage = window.location.pathname.includes('/photos');
            const sidebar = document.getElementById('sidebar-container');
            const mainGrid = document.getElementById('main-grid');
            if (isPhotoPage && sidebar) {
                sidebar.style.display = 'none';
                if (mainGrid) mainGrid.style.gridTemplateColumns = '1fr';
            }
        }
        handleSidebar();
        document.addEventListener('swup:content_replaced', handleSidebar);
    </script>
</MainGridLayout>
