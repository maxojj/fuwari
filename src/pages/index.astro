---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="西灵号" description="Digital Space">
  <div class="card-base welcome-card p-8 md:p-10">

    <div class="mt-6 max-w-2xl space-y-4 leading-8 text-black/65 dark:text-white/65">
      <p>「西灵号」取自阿瑟·克拉克的科幻小说《月海沉船》。</p>
      <p>它因人类的高傲显得不可一世，在宇宙面前不堪一击，却使得人类幸存。</p>
      <p>愿你也能拥有一艘「西灵号」。</p>
    </div>
  </div>

  <section class="section-block" aria-labelledby="works-title">
    <div class="section-heading">
      <div>
        <h2 id="works-title" class="mt-2 text-3xl font-bold tracking-tight">Works</h2>
      </div>
      <span class="section-mark" aria-hidden="true">✦</span>
    </div>

    <div class="works-grid">
      <a href="https://twitter.feimind.xyz/" target="_blank" rel="noopener noreferrer" class="work-card">
        <h3>💊 闪念胶囊</h3>
        <p>记录一些即时想法、吐槽和日常</p>
        <span class="card-arrow" aria-hidden="true">↗</span>
      </a>

      <a href="https://ins.feimind.xyz/" target="_blank" rel="noopener noreferrer" class="work-card">
        <h3>📷 Moments</h3>
        <p>保存生活里值得记录的片段与瞬间</p>
        <span class="card-arrow" aria-hidden="true">↗</span>
      </a>

      <a href="/posts" class="work-card">
        <h3>📝 Classic Blog</h3>
        <p>长文与思考</p>
        <span class="card-arrow" aria-hidden="true">→</span>
      </a>

      <a href="/about" class="work-card">
        <h3>🚧 More</h3>
        <p>施工中</p>
        <span class="card-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section-block" aria-labelledby="journey-title">
    <div class="section-heading">
      <div>
        <h2 id="journey-title" class="mt-2 text-3xl font-bold tracking-tight">🌍 Journey</h2>
      </div>
    </div>


    <div class="card-base embed-card">
      <iframe
        src="https://www.google.com/maps/d/embed?mid=1tVuHkUA1rEgdLptEIvFdNLwiMmHY1vM&ehbc=2E312F"
        title="我的旅行地图"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section class="section-block" aria-labelledby="guestbook-title">
    <div class="section-heading">
      <div>
        <h2 id="guestbook-title" class="mt-2 text-3xl font-bold tracking-tight">📮 Guestbook</h2>
      </div>
    </div>

    <div class="card-base embed-card">
      <iframe
        src="https://www.joey.team/b/AEkuEWE9U33TvwLosM63"
        title="Guestbook 留言板"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</MainGridLayout>

<style>
  .section-block { margin-top: 3.5rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; border-bottom: 1px solid rgb(0 0 0 / 0.1); padding-bottom: 1rem; margin-bottom: 1.5rem; }
  :global(.dark) .section-heading { border-color: rgb(255 255 255 / 0.1); }
  .eyebrow { color: var(--primary); font-size: .7rem; font-weight: 700; letter-spacing: .16em; }
  .section-mark { color: var(--primary); font-size: 1.5rem; }
  .works-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .work-card { position: relative; min-height: 9.5rem; border: 1px solid rgb(0 0 0 / .1); border-radius: 1rem; padding: 1.35rem; background: rgb(255 255 255 / .42); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  :global(.dark) .work-card { border-color: rgb(255 255 255 / .12); background: rgb(255 255 255 / .04); }
  .work-card:hover { transform: translateY(-4px); border-color: var(--primary); box-shadow: 0 12px 30px rgb(0 0 0 / .08); }
  .work-card:focus-visible, .travel-link:focus-visible { outline: 3px solid var(--primary); outline-offset: 4px; }
  .work-card h3 { padding-right: 1.5rem; font-size: 1.05rem; font-weight: 700; }
  .work-card p { margin-top: .75rem; color: rgb(0 0 0 / .52); font-size: .875rem; line-height: 1.6; }
  :global(.dark) .work-card p { color: rgb(255 255 255 / .52); }
  .card-arrow { position: absolute; right: 1.25rem; bottom: 1.15rem; color: var(--primary); font-size: 1.2rem; }
  .travel-link { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; color: var(--primary); font-size: .9rem; font-weight: 600; }
  .embed-card { overflow: hidden; padding: .5rem; }
  .embed-card iframe { display: block; width: 100%; height: 31.25rem; border: 0; border-radius: .75rem; }
  @media (max-width: 640px) { .works-grid { grid-template-columns: 1fr; } .welcome-card { padding: 1.5rem; } .embed-card iframe { height: 25rem; } }
  @media (prefers-reduced-motion: reduce) { .work-card { transition: none; } .work-card:hover { transform: none; } }
</style>
