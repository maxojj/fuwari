---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="西灵号"
  description="Max Lu's Digital Space"
>

  <!-- 首页介绍 -->

  <div class="card-base p-8 mb-8">

    <div class="leading-8 opacity-80">

      <p>
        「西灵号」取自
        <a
          href="https://book.douban.com/author/4522301/"
          target="_blank"
          rel="noopener noreferrer"
        >
          阿瑟·克拉克
        </a>
        的科幻小说《
        <a
          href="https://book.douban.com/subject/10570094/"
          target="_blank"
          rel="noopener noreferrer"
        >
          月海沉船
        </a>
        》。
      </p>

      <p class="mt-4">
        它因人类的高傲显得不可一世，
        在宇宙面前不堪一击，
        却使得人类幸存。
      </p>

      <p class="mt-4">
        愿你也能拥有一艘「西灵号」。
      </p>

    </div>

  </div>



<!-- ========================= -->
<!-- Works -->
<!-- ========================= -->

<section class="mb-12">

  <h2 class="text-3xl font-bold tracking-tight">
    👨‍🌾 Works
  </h2>

  <div class="w-12 h-1 rounded-full bg-[var(--primary)] mt-3 mb-8"></div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <!-- Flash Thoughts -->

    <div
      class="
        card-base
        p-8
        min-h-[180px]
        transition-all
        duration-300
        hover:-translate-y-1
        hover:shadow-xl
      "
    >
      <div class="text-5xl mb-5">
        💊
      </div>

      <h3 class="text-2xl font-bold">
        Flash Thoughts
      </h3>

      <p class="mt-3 opacity-60">
        情绪 / 吐槽 / 动态
      </p>
    </div>



    <!-- Moments -->

    <div
      class="
        card-base
        p-8
        min-h-[180px]
        transition-all
        duration-300
        hover:-translate-y-1
        hover:shadow-xl
      "
    >
      <div class="text-5xl mb-5">
        📸
      </div>

      <h3 class="text-2xl font-bold">
        Moments
      </h3>

      <p class="mt-3 opacity-60">
        一些瞬间
      </p>
    </div>



    <!-- Classic Blog -->

    <div
      class="
        card-base
        p-8
        min-h-[180px]
        transition-all
        duration-300
        hover:-translate-y-1
        hover:shadow-xl
      "
    >
      <div class="text-5xl mb-5">
        📝
      </div>

      <h3 class="text-2xl font-bold">
        Classic Blog
      </h3>

      <p class="mt-3 opacity-60">
        长文、分享
      </p>
    </div>



    <!-- More -->

    <div
      class="
        card-base
        p-8
        min-h-[180px]
        transition-all
        duration-300
        hover:-translate-y-1
        hover:shadow-xl
      "
    >
      <div class="text-5xl mb-5">
        🚧
      </div>

      <h3 class="text-2xl font-bold">
        More
      </h3>

      <p class="mt-3 opacity-60">
        调整施工 ing
      </p>
    </div>

  </div>

</section>


  <!-- Journey -->

  <section class="mb-10">

    <h2 class="text-3xl font-bold tracking-tight">
  🌍 Journey
</h2>

<div class="w-12 h-1 rounded-full bg-[var(--primary)] mt-3 mb-8"></div>

    <div class="card-base p-4 overflow-hidden">

      <iframe
        src="https://www.google.com/maps/d/embed?mid=1tVuHkUA1rEgdLptEIvFdNLwiMmHY1vM&ehbc=2E312F"
        width="100%"
        height="500"
        loading="lazy"
        style="border:0;"
        class="rounded-xl"
      >
      </iframe>

    </div>

  </section>



  <!-- Guestbook -->

  <section class="mb-10">

    <h2 class="text-3xl font-bold tracking-tight">
  💬 Guestbook
</h2>

<div class="w-12 h-1 rounded-full bg-[var(--primary)] mt-3 mb-8"></div>

    <div class="card-base p-4 overflow-hidden">

      <iframe
        src="https://www.joey.team/b/AEkuEWE9U33TvwLosM63"
        width="100%"
        height="500"
        loading="lazy"
        style="border:0;"
        class="rounded-xl"
      >
      </iframe>

    </div>

  </section>

</MainGridLayout>
