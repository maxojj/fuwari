---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="西灵号"
  description="Max Lu's Digital Space"
>

  <!-- 首页介绍 -->

  <div class="card-base p-8 mb-8">

    <div class="leading-8 opacity-80">

      <p>
        「西灵号」取自
        <a
          href="https://book.douban.com/author/4522301/"
          target="_blank"
          rel="noopener noreferrer"
        >
          阿瑟·克拉克
        </a>
        的科幻小说《
        <a
          href="https://book.douban.com/subject/10570094/"
          target="_blank"
          rel="noopener noreferrer"
        >
          月海沉船
        </a>
        》。
      </p>

      <p class="mt-4">
        它因人类的高傲显得不可一世，
        在宇宙面前不堪一击，
        却使得人类幸存。
      </p>

      <p class="mt-4">
        愿你也能拥有一艘「西灵号」。
      </p>

    </div>

  </div>



 <!-- ========================= -->
<!-- Works -->
<!-- ========================= -->

<section class="mb-10">

  <h2 class="text-xl font-bold mb-6">
    👨‍🌾 Works
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <div class="card-base p-8 min-h-[180px]">
      <div class="text-3xl mb-4">💊</div>

      <h3 class="text-xl font-semibold">
        Flash Thoughts
      </h3>

      <p class="opacity-70 mt-4">
        情绪 / 吐槽 / 动态
      </p>
    </div>

    <div class="card-base p-8 min-h-[180px]">
      <div class="text-3xl mb-4">📸</div>

      <h3 class="text-xl font-semibold">
        Moments
      </h3>

      <p class="opacity-70 mt-4">
        一些瞬间
      </p>
    </div>

    <div class="card-base p-8 min-h-[180px]">
      <div class="text-3xl mb-4">📝</div>

      <h3 class="text-xl font-semibold">
        Classic Blog
      </h3>

      <p class="opacity-70 mt-4">
        长文、分享
      </p>
    </div>

    <div class="card-base p-8 min-h-[180px]">
      <div class="text-3xl mb-4">🚧</div>

      <h3 class="text-xl font-semibold">
        More
      </h3>

      <p class="opacity-70 mt-4">
        调整施工 ing
      </p>
    </div>

  </div>

</section>


  <!-- Journey -->

  <section class="mb-10">

    <h2 class="text-xl font-bold mb-6">
      🌍 Journey
    </h2>

    <div class="card-base p-4 overflow-hidden">

      <iframe
        src="https://www.google.com/maps/d/embed?mid=1tVuHkUA1rEgdLptEIvFdNLwiMmHY1vM&ehbc=2E312F"
        width="100%"
        height="500"
        loading="lazy"
        style="border:0;"
        class="rounded-xl"
      >
      </iframe>

    </div>

  </section>



  <!-- Guestbook -->

  <section class="mb-10">

    <h2 class="text-xl font-bold mb-6">
      💬 Guestbook
    </h2>

    <div class="card-base p-4 overflow-hidden">

      <iframe
        src="https://www.joey.team/b/AEkuEWE9U33TvwLosM63"
        width="100%"
        height="500"
        loading="lazy"
        style="border:0;"
        class="rounded-xl"
      >
      </iframe>

    </div>

  </section>

</MainGridLayout>
