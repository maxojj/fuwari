---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="西灵号"
  description="Digital Space"
>

<!-- ===================================== -->
<!-- 欢迎语 -->
<!-- ===================================== -->

<div class="card-base p-8">

  <h1 class="text-3xl font-bold mb-6">
    「西灵号」欢迎您
  </h1>

  <div class="leading-8 opacity-80">

    <p>
      「西灵号」取自阿瑟·克拉克的科幻小说《月海沉船》。
    </p>

    <p class="mt-4">
      它因人类的高傲显得不可一世，
      在宇宙面前不堪一击，
      却使得人类幸存。
    </p>

    <p class="mt-4">
      愿你也能拥有一艘「西灵号」。
    </p>

  </div>

</div>



<!-- ===================================== -->
<!-- Works -->
<!-- ===================================== -->

<section class="mt-12">

  <h2 class="text-3xl font-bold">
    Works
  </h2>

  <div class="border-b border-black/10 dark:border-white/10 mt-3 mb-6"></div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <!-- Flash Thoughts -->

    <a
      href="https://twitter.feimind.xyz/"
      target="_blank"
      rel="noopener noreferrer"
      class="card-base p-5 transition hoverck/50 dark:text-white/50 mt-2">
        情绪 / 吐槽 / 动态
      </p>

    </a>



    <!-- Moments -->

    <a
      href="https://ins.feimind.xyz/"
      target="_blank"
      rel="noopener noreferrer"
      classp class="text-sm text-black/50 dark:text-white/50 mt-2">
        一些瞬间
      </p>

    </a>



    <!-- Blog -->

    <a
      href="/posts"
      class="t-semibold">
        📝 Blog
      </h3>

      <p class="text-sm text-black/50 dark:text-white/50 mt-2">
        长文与思考
      </p>

    </a>



    <!-- More -->

    <a
      href="/about"
      classont-semibold">
        ➕ More
      </h3>

      <p class="text-sm text-black/50 dark:text-white/50 mt-2">
        更多探索
      </p>

    </a>

  </div>

</section>



<!-- ===================================== -->
<!-- Journey -->
<!-- ===================================== -->

<section class="mt-12">

  <h2 class="text-3xl font-bold">
    Journey
  </h2>

  <div class="border-b border-black/10 dark:border-white/10 mt-3 mb-6"></div>

  <a
    href="/places"
    class="ont-semibold">
      🌍 Travel Map
    </h3>

    <p class="text-sm text-black/50 dark:text-white/50 mt-2">
      查看我去过的地方和旅行足迹
    </p>

  </a>

</section>


  <!-- Journey -->

  <section class="mb-10">

    <h2 class="text-3xl font-bold tracking-tight">
  🌍 Journey
</h2>

<div class="w-12 h-1 rounded-full bg-[var(--primary)] mt-3 mb-8"></div>

    <div class="card-base p-4 overflow-hidden">

      <iframe
        src="https://www.google.com/maps/d/embed?mid=1tVuHkUA1rEgdLptEIvFdNLwiMmHY1vM&ehbc=2E312F"
        width="100%"
        height="500"
        loading="lazy"
        style="border:0;"
        class="rounded-xl"
      >
      </iframe>

    </div>

  </section>



  <!-- Guestbook -->

  <section class="mb-10">

    <h2 class="text-3xl font-bold tracking-tight">
  💬 Guestbook
</h2>

<div class="w-12 h-1 rounded-full bg-[var(--primary)] mt-3 mb-8"></div>

    <div class="card-base p-4 overflow-hidden">

      <iframe
        src="https://www.joey.team/b/AEkuEWE9U33TvwLosM63"
        width="100%"
        height="500"
        loading="lazy"
        style="border:0;"
        class="rounded-xl"
      >
      </iframe>

    </div>

  </section>

</MainGridLayout>
