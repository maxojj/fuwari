---
/**
 * 首页
 *
 * 文件位置：
 * src/pages/index.astro
 *
 * 修改说明：
 *
 * 1. 修改首页介绍
 *    直接修改下面介绍文字即可
 *
 * 2. 修改入口链接
 *    修改 href
 *
 * 3. 修改入口标题
 *    修改 Flash Thoughts / Moments / Blog / More
 *
 * 4. Journey 后续可以替换为 Google Map
 */

import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="西灵号"
  description="Max Lu's Digital Space"
>

  <!-- ========================= -->
  <!-- 首页介绍 -->
  <!-- ========================= -->

  <div class="card-base p-8 mb-8">

    <div class="leading-8 opacity-80">

      <p>
        「西灵号」取自
        <a
          href="https://book.douban.com/author/4522301/"
          target="_blank"
          rel="noopener noreferrer"
        >
          阿瑟·克拉克
        </a>
        的科幻小说《
        <a
          href="https://book.douban.com/subject/10570094/"
          target="_blank"
          rel="noopener noreferrer"
        >
          月海沉船
        </a>
        》。
      </p>

      <p class="mt-4">
        它因人类的高傲显得不可一世，
        在宇宙面前不堪一击，
        却使得人类幸存。
      </p>

      <p class="mt-4">
        愿你也能拥有一艘「西灵号」。
      </p>

    </div>

  </div>



  <!-- ========================= -->
  <!-- Works -->
  <!-- ========================= -->

  <section class="mb-10">

    <h2 class="text-xl font-bold mb-4">
      Works
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      <!-- Flash Thoughts -->

      <a
        href="/thoughts"
        class="card-base p-6 block hover:scale-[1.01] transition3>

        <p class="opacity-70 mt-2">
          Quick thoughts and notes.
        </p>
      </a>



      <!-- Moments -->

      <a
        href="/moments"
"font-semibold text-lg">
          📸 Moments
        </h3>

        <p class="opacity-70 mt-2">
          Photos and snapshots.
        </p>
      </a>



      <!-- Blog -->

      <a
        href="/posts"
        class="card-base p-6 block hover:scale-[   </h3>

        <p class="opacity-70 mt-2">
          Long-form writing.
        </p>
      </a>



      <!-- More -->

      <a
        href="/about"
        class="card-base           ➕ More
        </h3>

        <p class="opacity-70 mt-2">
          More explorations.
        </p>
      </a>

    </div>

  </section>



  <!-- ========================= -->
  <!-- Journey -->
  <!-- ========================= -->

  <section>

    <h2 class="text-xl font-bold mb-4">
      Journey
    </h2>

    <a
      href="/places"
      class=ve been and journeys I've taken.
      </p>

      <p class="mt-3 text-[var(--primary)]">
        Open Travel Map →
      </p>

    </a>

  </section>

</MainGridLayout>
