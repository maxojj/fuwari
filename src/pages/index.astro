---
/**
 * 首页
 *
 * 文件位置：
 * src/pages/index.astro
 *
 * 用途：
 * 网站门户页
 *
 * 修改说明：
 *
 * 1. 首页欢迎语
 * 修改「西灵号欢迎您」和下面那段文字
 *
 * 2. Works入口
 * 修改对应链接即可
 *
 * 3. Journey
 * 后续换成 Google Map
 */

import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="西灵号"
  description="Max Lu's Digital Space"
>

  <!-- ===================== -->
  <!-- 欢迎语 -->
  <!-- ===================== -->

  <div class="card-base p-8">

    <h1 class="text-4xl font-bold">
      「西灵号」欢迎您
    </h1>

    <p class="mt-6 leading-8 opacity-80">
      「西灵号」取自阿瑟·克拉克的科幻小说《与拉玛相会》。
      它因人类的高傲而显得不可一世，
      在宇宙面前却不堪一击，
      却使得人类幸存。

      愿你也能拥有一艘「西灵号」。
    </p>

  </div>


  <!-- ===================== -->
  <!-- Works -->
  <!-- ===================== -->

  <section class="mt-10">

    <h2 class="text-3xl font-bold mb-6">
      🚀 Works
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      <!-- Flash Thoughts -->

      <a
        href="/thoughts"
 text-xl font-semibold">
          💊 Flash Thoughts
        </h3>

        <p class="mt-3 opacity-70">
          Quick notes and random thoughts.
        </p>
      </a>


      <!-- Moments -->

      <a
        href="/moments"
        class-semibold">
          📸 Moments
        </h3>

        <p class="mt-3 opacity-70">
          Photos and snapshots.
        </p>
      </a>


      <!-- Blog -->

      <a
        href="/posts"
        class="emibold">
          📝 Blog
        </h3>

        <p class="mt-3 opacity-70">
          Long-form writing and sharing.
        </p>
      </a>


      <!-- More -->

      <a
        href<h3 class="text-xl font-semibold">
          ➕ More
        </h3>

        <p class="mt-3 opacity-70">
          More explorations and adventures.
        </p>
      </a>

    </div>

  </section>


  <!-- ===================== -->
  <!-- Journey -->
  <!-- ===================== -->

  <section class="mt-10">

    <h2 class="text-3xl font-bold mb-6">
      🌍 Journey
    </h2>

    <a
      href="/places"
      class="card-basees I've been and journeys I've taken.
      </p>

      <p class="mt-4 text-[var(--primary)]">
        Open Travel Map →
      </p>
    </a>

  </section>

</MainGridLayout>
