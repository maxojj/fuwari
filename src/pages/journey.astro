---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import citiesData from "../content/cities.json";

interface City {
  city: string;
  country: string;
  lat: number;
  lng: number;
  date: string;
  rating: "love" | "smile" | "cry";
  comment: string;
}

const cities = (citiesData || []) as City[];

const ratingConfig: Record<string, { label: string; symbol: string; color: string }> = {
  love: { label: "强烈推荐", symbol: "🥰", color: "#e74c3c" },
  smile: { label: "值得一去", symbol: "🙂", color: "#f39c12" },
  cry: { label: "不太推荐", symbol: "😤", color: "#7f8c8d" },
};

const formatDate = (date: string) => {
  if (!date) return "";
  const d = new Date(`${date}T00:00:00`);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("zh-CN", { year: "numeric", month: "long" });
};
---

<MainGridLayout title="Journey" description="我去过的地方" showSidebar={false} wide={true}>
    <Fragment slot="head">
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    </Fragment>

    <div class="max-w-[1200px] mx-auto pb-10 px-4 md:px-0">
        <!-- 页面标题和介绍 -->
        <header class="mb-8 pt-2 md:pt-4">
            <h1 class="text-2xl md:text-3xl font-bold text-black/75 dark:text-white/75 mb-3">
                我去过的地方
            </h1>
            <div class="max-w-2xl text-sm leading-7 text-black/55 dark:text-white/55 md:text-base">
                <p>🗺️ 每个城市都有它的味道，有的想再去，有的不想再提。</p>
                <p>点击地图上的标记，看看我怎么说。</p>
            </div>
        </header>

        <!-- 地图容器 -->
        <div id="journey-map" class="w-full h-[300px] md:h-[500px] rounded-2xl overflow-hidden border border-black/5 dark:border-white/10 shadow-lg bg-zinc-100 dark:bg-zinc-900">
        </div>

        <!-- 城市列表 -->
        <div class="mt-8">
            <h2 class="text-lg font-bold text-black/70 dark:text-white/70 mb-4">城市列表</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {cities.map((c) => (
                    <div class="flex items-start gap-3 p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 transition hover:shadow-lg">
                        <div class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white text-sm font-bold shadow"
                             style={`background-color: ${ratingConfig[c.rating].color}; border: 2px solid rgba(255,255,255,0.3);`}>
                            {ratingConfig[c.rating].symbol}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                <span class="font-bold text-black/75 dark:text-white/75">{c.city}</span>
                                <span class="text-sm text-black/40 dark:text-white/40">{c.country}</span>
                                <span class="text-sm text-black/40 dark:text-white/40">·</span>
                                <time class="text-sm text-black/40 dark:text-white/40" datetime={c.date}>{formatDate(c.date)}</time>
                            </div>
                            <p class="mt-1 text-sm text-black/50 dark:text-white/50 line-clamp-2">{c.comment}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ cities, ratingConfig }}>
        function initJourneyMap() {
            if (typeof L === "undefined") {
                setTimeout(initJourneyMap, 100);
                return;
            }
            if (!document.getElementById("journey-map")) return;
            if (document.getElementById("journey-map")._leaflet_id) return;
        (function () {

            function isDark() {
                return document.documentElement.classList.contains("dark");
            }

            var darkUrl = "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";
            var lightUrl = "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";

            var map = L.map("journey-map", {
                center: [30, 105],
                zoom: 4,
                zoomControl: true,
                scrollWheelZoom: true,
            });

            var currentLayer = L.tileLayer(isDark() ? darkUrl : lightUrl, {
                attribution: 'attribution: '&copy; OpenStreetMap &copy; CARTO'copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors',
                subdomains: "abcd",
                maxZoom: 19,
            }).addTo(map);

            function makeIcon(rating) {
                var cfg = ratingConfig[rating];
                var html = '<div style="'
                    + 'width:28px;height:28px;border-radius:50%;'
                    + 'background-color:' + cfg.color + ';'
                    + 'border:2px solid rgba(255,255,255,0.4);'
                    + 'box-shadow:0 2px 6px rgba(0,0,0,0.35);'
                    + 'display:flex;align-items:center;justify-content:center;'
                    + 'color:#fff;font-size:14px;font-weight:bold;line-height:1;'
                    + '">' + cfg.symbol + '</div>';
                return L.divIcon({
                    html: html,
                    className: "journey-marker",
                    iconSize: [28, 28],
                    iconAnchor: [14, 14],
                    popupAnchor: [0, -16],
                });
            }

            function popupHtml(c) {
                var cfg = ratingConfig[c.rating];
                return '<div class="journey-popup" style="min-width:200px;">'
                    + '<div style="font-weight:bold;font-size:15px;margin-bottom:2px;">' + c.city + ', ' + c.country + '</div>'
                    + '<div style="font-size:13px;opacity:0.7;margin-bottom:6px;">' + c.date + ' · ' + cfg.label + '</div>'
                    + '<div style="font-size:13px;line-height:1.6;">' + c.comment + '</div>'
                    + '</div>';
            }

            cities.forEach(function (c) {
                L.marker([c.lat, c.lng], { icon: makeIcon(c.rating) })
                    .addTo(map)
                    .bindPopup(popupHtml(c), { closeButton: true, autoClose: true });
            });

            // 主题切换时动态更换底图
            var observer = new MutationObserver(function () {
                var dark = isDark();
                var wantUrl = dark ? darkUrl : lightUrl;
                if (currentLayer instanceof L.TileLayer) {
                    var curUrl = currentLayer._url;
                    if (curUrl !== wantUrl) {
                        map.removeLayer(currentLayer);
                        currentLayer = L.tileLayer(wantUrl, {
                            attribution: 'attribution: '&copy; OpenStreetMap &copy; CARTO'copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors',
                            subdomains: "abcd",
                            maxZoom: 19,
                        }).addTo(map);
                    }
                }
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

            // swup 页面切换后重新计算尺寸
            document.addEventListener("swup:content_replaced", function () {
                if (map && document.getElementById("journey-map")) {
                    setTimeout(function () { map.invalidateSize(); }, 200);
                }
            });
        })();
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initJourneyMap);
        } else {
            initJourneyMap();
        }
        document.addEventListener('swup:page:view', initJourneyMap);
    </script>

    <style is:global>
        .journey-popup {
            color: var(--popup-text, #fff);
        }
        .dark .leaflet-popup-content-wrapper,
        .dark .leaflet-popup-tip {
            background: #1e1e1e !important;
            color: #f0f0f0 !important;
            box-shadow: 0 3px 14px rgba(0,0,0,0.5) !important;
        }
        .dark .leaflet-popup-content-wrapper {
            border: 1px solid rgba(255,255,255,0.1);
        }
        .dark .leaflet-container {
            background: #1a1a1a !important;
        }
        .dark .leaflet-bar a {
            background: #2a2a2a !important;
            color: #f0f0f0 !important;
            border-color: rgba(255,255,255,0.1) !important;
        }
        .dark .leaflet-bar a:hover {
            background: #3a3a3a !important;
        }
        /* 浅色模式 */
        .leaflet-popup-content-wrapper {
            background: #fff;
            color: #333;
        }
        .leaflet-container {
            background: #f4f4f4;
        }
        /* popup 内文字 */
        .leaflet-popup-content {
            margin: 12px 16px;
            line-height: 1.5;
        }
        .journey-marker {
            background: transparent !important;
            border: none !important;
        }
    </style>
</MainGridLayout>
