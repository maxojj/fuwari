---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import moviesData from "../content/movies.json";

interface Movie {
  title: string;
  poster: string;
  year: string;
  rating: number; 
  comment: string;
  link: string;
}

// 这里保留 json 中的原始顺序（已经在 Python 端打乱过，直接取最近的 50 条）
const movies = (moviesData || []).slice(0, 50) as Movie[];

// 评分转换函数
const formatRating = (rating: number) => {
  if (!rating || rating === 0) return "未评分";
  return (rating / 2).toFixed(1);
}

// 星星生成逻辑
const getStars = (rating: number) => {
  if (!rating || rating === 0) return "";
  return "⭐".repeat(Math.floor(rating / 2));
}
---

<MainGridLayout title="Movies" description="影音剧" showSidebar={false} wide={true}>
    
    <div class="max-w-[1200px] mx-auto pb-10 px-4 md:px-0">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
            {movies.map((movie) => (
                <div class="group relative flex flex-col rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
                    
                    <div class="relative aspect-[2/3] overflow-hidden">
                        <img 
                            src={movie.poster} 
                            alt={movie.title} 
                            loading="lazy"
                            referrerpolicy="no-referrer"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                        />
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-transparent flex flex-col justify-end p-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-[2px]">
                            <p class="text-white text-[13px] leading-relaxed italic line-clamp-6 mb-4">
                                {movie.comment ? `“ ${movie.comment} ”` : "观毕，暂无评价"}
                            </p>
                            <a href={movie.link} target="_blank" class="w-full text-[11px] text-center py-2 bg-white/10 hover:bg-[var(--primary)] text-white border border-white/20 rounded-lg transition-colors">
                                查看详情
                            </a>
                        </div>
                    </div>

                    <div class="p-4 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-md">
                        {/* 标题：调大到 text-base (16px) 并加粗 */}
                        <h3 class="text-base font-bold truncate mb-1 text-zinc-800 dark:text-zinc-100" title={movie.title}>
                            {movie.title}
                        </h3>
                        <div class="flex flex-col gap-1">
                            {/* 评分行：星星和加粗的数字评分 */}
                            <div class="flex items-center gap-2">
                                <span class="text-yellow-500 text-[11px]">{getStars(movie.rating)}</span>
                                <span class="text-zinc-500 dark:text-zinc-400 font-bold font-mono text-[13px]">
                                    {formatRating(movie.rating)}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

    {/* 侧边栏控制脚本逻辑不变 */}
    <script is:inline>
        function handleSidebarDisplay() {
            const sidebar = document.getElementById('sidebar-container');
            const mainGrid = document.getElementById('main-grid');
            const mainElement = document.querySelector('main');
            const isMoviePage = window.location.pathname.includes('/movies');
            if (isMoviePage) {
                if (sidebar) sidebar.style.display = 'none';
                if (mainGrid) { mainGrid.style.gridTemplateColumns = '1fr'; mainGrid.style.maxWidth = '100%'; }
                if (mainElement) { mainElement.style.gridColumn = 'span 1 / span 1'; mainElement.style.width = '100%'; }
            } else {
                if (sidebar) sidebar.style.display = '';
                if (mainGrid) { mainGrid.style.gridTemplateColumns = ''; mainGrid.style.maxWidth = ''; }
                if (mainElement) { mainElement.style.gridColumn = ''; mainElement.style.width = ''; }
            }
        }
        handleSidebarDisplay();
        document.addEventListener('swup:content_replaced', handleSidebarDisplay);
    </script>
</MainGridLayout>

<style>
    .line-clamp-6 {
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
