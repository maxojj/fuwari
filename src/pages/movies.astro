---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import moviesData from "../content/movies.json";

// ... 之前的接口和函数保持不变 ...

const movies = (moviesData || []) as Movie[];
---

<!-- 这里的 hasSidebar={false} 会触发你刚才在 Layout 里写的逻辑 -->
<MainGridLayout title="电影墙" hasSidebar={false}>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-4">
        {movies.map((movie) => (
            <div class="group relative flex flex-col rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 overflow-hidden hover:shadow-xl transition-all duration-300">
                
                {/* 海报与悬浮层代码保持不变 */}
                <div class="relative aspect-[2/3] overflow-hidden">
                    <img 
                        src={movie.poster} 
                        alt={movie.title} 
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" 
                    />
                    
                    <div class="absolute inset-0 bg-black/80 flex flex-col justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-sm">
                        <p class="text-white text-sm leading-relaxed italic line-clamp-6">
                            {movie.comment ? `“ ${movie.comment} ”` : "暂无评价"}
                        </p>
                        <a href={movie.link} target="_blank" class="mt-4 text-[10px] text-[var(--primary)] border border-[var(--primary)] rounded py-1 px-2 text-center hover:bg-[var(--primary)] hover:text-white transition-colors">
                            查看详情
                        </a>
                    </div>
                </div>

                {/* 底部标题和评分 */}
                <div class="p-2 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-md">
                    <h3 class="text-xs font-bold truncate mb-1" title={movie.title}>
                        {movie.title}
                    </h3>
                    <div class="flex items-center justify-between">
                        <div class="text-[10px] text-yellow-500 flex items-center">
                            {movie.rating > 0 ? (
                                <>
                                    <span class="mr-1">{"⭐".repeat(Math.floor(movie.rating/2))}</span>
                                    <span class="text-zinc-400 font-mono">{(movie.rating/2).toFixed(1)}</span>
                                </>
                            ) : (
                                <span class="text-zinc-500 italic">未评分</span>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</MainGridLayout>

<style>
    .line-clamp-6 {
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
