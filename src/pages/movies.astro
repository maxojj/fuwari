---
const response = await fetch(
  new URL('../../public/data/movie.json', import.meta.url)
);

const data = await response.json();
const movies = data.data ?? [];
---

<h1>Movies</h1>

<div>
{
  movies.map((m) => (
    <div>
      <img
        src={m.item.cover_image_url}
        width="120"
     {m.rating_grade / 2} ★</p>
    </div>
  ))
}
</div>
``
