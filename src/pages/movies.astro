---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import moviesData from "../content/movies.json";

interface Movie {
  title: string;
  poster: string;
  rating: number;
  comment: string;
  date: string;
  link: string;
}

const movies = (moviesData || []) as Movie[];

// 评分转换：8 -> 4.0
const formatRating = (rating: number) => {
  if (!rating || rating === 0) return "未评分";
  return (rating / 2).toFixed(1);
}

// 星星显示
const getStars = (rating: number) => {
  if (!rating || rating === 0) return "";
  return "⭐".repeat(Math.floor(rating / 2));
}
---

<MainGridLayout title="电影墙">
    
    <div class="max-w-[1200px] mx-auto pb-10 px-4 md:px-0">
        <!-- 桌面端固定 5 列海报 -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
            {movies.map((movie) => (
                <div class="group relative flex flex-col rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
                    
                    {/* 海报与悬浮评论层 */}
                    <div class="relative aspect-[2/3] overflow-hidden">
                        <img 
                            src={movie.poster} 
                            alt={movie.title} 
                            loading="lazy"
                            referrerpolicy="no-referrer"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                        />
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-transparent flex flex-col justify-end p-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-[2px]">
                            <p class="text-white text-[13px] leading-relaxed italic line-clamp-6 mb-4">
                                {movie.comment ? `“ ${movie.comment} ”` : "暂无评价"}
                            </p>
                            <a 
                                href={movie.link} 
                                target="_blank" 
                                class="w-full text-[11px] text-center py-2 bg-white/10 hover:bg-[var(--primary)] text-white border border-white/20 rounded-lg transition-colors"
                            >
                                查看详情
                            </a>
                        </div>
                    </div>

                    {/* 底部标题和评分 */}
                    <div class="p-4 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-md">
                        <h3 class="text-sm font-bold truncate mb-2" title={movie.title}>
                            {movie.title}
                        </h3>
                        <div class="flex items-center gap-2">
                            <span class="text-yellow-500 text-[10px]">
                                {getStars(movie.rating)}
                            </span>
                            <span class="text-zinc-400 font-mono text-xs">
                                {formatRating(movie.rating)}
                            </span>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

    {/* 核心脚本：处理侧边栏显示/隐藏逻辑及 Swup 兼容性 */}
    <script is:inline>
        function handleSidebarDisplay() {
            const sidebar = document.getElementById('sidebar-container');
            const mainGrid = document.getElementById('main-grid');
            const mainElement = document.querySelector('main');

            // 检查当前是否在电影页面
            const isMoviePage = window.location.pathname.includes('/movies');

            if (isMoviePage) {
                // 电影页：隐藏侧边栏并拉伸内容区
                if (sidebar) sidebar.style.display = 'none';
                if (mainGrid) {
                    mainGrid.style.gridTemplateColumns = '1fr';
                    mainGrid.style.maxWidth = '100%';
                }
                if (mainElement) {
                    mainElement.style.gridColumn = 'span 1 / span 1';
                    mainElement.style.width = '100%';
                }
            } else {
                // 非电影页：恢复布局
                if (sidebar) sidebar.style.display = '';
                if (mainGrid) {
                    mainGrid.style.gridTemplateColumns = '';
                    mainGrid.style.maxWidth = '';
                }
                if (mainElement) {
                    mainElement.style.gridColumn = '';
                    mainElement.style.width = '';
                }
            }
        }

        // 页面初始化时运行
        handleSidebarDisplay();

        // 监听 Swup 页面替换完成事件
        document.addEventListener('swup:content_replaced', handleSidebarDisplay);
        
        // 兼容性辅助
        window.addEventListener('popstate', handleSidebarDisplay);
    </script>

</MainGridLayout>

<style>
    /* 评价文字截断 */
    .line-clamp-6 {
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
