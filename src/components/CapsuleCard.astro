---
interface RichText {
  type?: string;
  text?: string;
  href?: string;
  annotations?: {
    bold?: boolean;
    italic?: boolean;
    strikethrough?: boolean;
    underline?: boolean;
    code?: boolean;
  };
}

interface CapsuleBlock {
  type?: string;
  text?: string;
  url?: string;
  href?: string;
  caption?: string;
  alt?: string;
  children?: RichText[];
  rich_text?: RichText[];
}

interface Capsule {
  id?: string;
  date?: string;
  tags?: string[];
  tag?: string | string[];
  blocks?: CapsuleBlock[];
}

interface Props {
  capsule: Capsule;
}

const { capsule } = Astro.props;

const date = capsule.date || "";
const blocks = capsule.blocks || [];

const tags = [
  ...(Array.isArray(capsule.tags) ? capsule.tags : []),
  ...(Array.isArray(capsule.tag)
    ? capsule.tag
    : capsule.tag
      ? [capsule.tag]
      : []),
].filter(Boolean);

const uniqueTags = [...new Set(tags)];

function escapeHtml(value: unknown) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function formatDate(value: string) {
  if (!value) return "";

  const parsed = new Date(value);

  if (Number.isNaN(parsed.getTime())) {
    return value.replaceAll("-", ".");
  }

  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  })
    .format(parsed)
    .replaceAll("/", ".");
}

function getRichText(block: CapsuleBlock) {
  return block.rich_text || block.children || [];
}

function getPlainText(block: CapsuleBlock) {
  if (block.text) return block.text;

  return getRichText(block)
    .map((item) => item.text || "")
    .join("");
}

function renderRichText(items: RichText[]) {
  return items
    .map((item) => {
      let content = escapeHtml(item.text || "");
      const annotations = item.annotations || {};

      if (annotations.code) {
        content = `
          <code class="rounded bg-black/5 px-1 py-0.5 font-mono text-sm dark:bg-white/10">
            ${content}
          </code>
        `;
      }

      if (annotations.bold) content = `<strong>${content}</strong>`;
      if (annotations.italic) content = `<em>${content}</em>`;
      if (annotations.strikethrough) content = `<s>${content}</s>`;
      if (annotations.underline) content = `<u>${content}</u>`;

      if (item.href) {
        content = `
          <a
            href="${escapeHtml(item.href)}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline max-w-full break-all text-[var(--primary)] underline decoration-[var(--primary)]/40 underline-offset-4"
          >
            ${content}
          </a>
        `;
      }

      return content;
    })
    .join("");
}

function renderBlock(block: CapsuleBlock) {
  const type = block.type || "paragraph";
  const richText = getRichText(block);

  const content =
    richText.length > 0
      ? renderRichText(richText)
      : escapeHtml(getPlainText(block));

  if (type === "image" && block.url) {
    return `
      <figure class="mt-4 max-w-full overflow-hidden rounded-xl">
        <img
          src="${escapeHtml(block.url)}"
          alt="${escapeHtml(block.alt || block.caption || "")}"
          loading="lazy"
          class="block h-auto max-w-full"
        />
        ${
          block.caption
            ? `
              <figcaption class="mt-2 text-center text-sm text-black/40 dark:text-white/40">
                ${escapeHtml(block.caption)}
              </figcaption>
            `
            : ""
        }
      </figure>
    `;
  }

  if (type === "divider") {
    return `<hr class="my-5 border-black/10 dark:border-white/10" />`;
  }

  if (type === "heading_1") {
    return `<h2 class="mt-5 mb-2 text-xl font-bold">${content}</h2>`;
  }

  if (type === "heading_2") {
    return `<h3 class="mt-4 mb-2 text-lg font-bold">${content}</h3>`;
  }

  if (type === "heading_3") {
    return `<h4 class="mt-4 mb-2 font-bold">${content}</h4>`;
  }

  if (type === "quote") {
    return `
      <blockquote class="my-4 max-w-full border-l-4 border-[var(--primary)]/40 pl-4 text-black/60 italic dark:text-white/60">
        ${content}
      </blockquote>
    `;
  }

  if (type === "bulleted_list_item") {
    return `<li class="ml-5 list-disc">${content}</li>`;
  }

  if (type === "numbered_list_item") {
    return `<li class="ml-5 list-decimal">${content}</li>`;
  }

  if (
    ["bookmark", "embed", "link_preview"].includes(type) &&
    (block.url || block.href)
  ) {
    const url = block.url || block.href || "";

    return `
      <a
        href="${escapeHtml(url)}"
        target="_blank"
        rel="noopener noreferrer"
        class="my-4 block max-w-full break-all rounded-xl border border-black/10 px-4 py-3 text-sm text-[var(--primary)] transition hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5"
      >
        ${escapeHtml(url)}
      </a>
    `;
  }

  return `<p class="mb-3 max-w-full last:mb-0">${content}</p>`;
}

const renderedBlocks = blocks.map(renderBlock).join("");
---

<article
  class="capsule-card min-w-0 max-w-full rounded-xl border border-black/10 bg-white/70 p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03]"
>
  <header class="mb-4 flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    <time
      datetime={date}
      class="shrink-0 font-mono text-black/45 dark:text-white/45"
    >
      {formatDate(date)}
    </time>

    {
      uniqueTags.length > 0 && (
        <div class="flex min-w-0 flex-wrap gap-x-3 gap-y-1">
          {uniqueTags.map((tag) => (
            <span class="break-all text-[var(--primary)]">#{tag}</span>
          ))}
        </div>
      )
    }
  </header>

  <div
    class="capsule-content min-w-0 max-w-full break-words text-[1rem] leading-8 text-black/80 dark:text-white/80"
    set:html={renderedBlocks}
  />
</article>

<style>
  .capsule-content {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .capsule-content :global(*) {
    max-width: 100%;
  }

  .capsule-content :global(p),
  .capsule-content :global(li),
  .capsule-content :global(blockquote),
  .capsule-content :global(a),
  .capsule-content :global(code) {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .capsule-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .capsule-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
