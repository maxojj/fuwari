---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];

	/**
	 * 是否显示侧边栏。
	 * 默认 true，保证博客页面保持原来的布局。
	 */
	showSidebar?: boolean;

	/**
	 * 无侧边栏页面是否使用较宽的内容区域。
	 * 例如 Twitter、Projects、About 可以设置为 true。
	 */
	wide?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	showSidebar = true,
	wide = false,
} = Astro.props;

const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;

const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

/**
 * 有侧边栏时使用站点原有宽度。
 *
 * 无侧边栏时：
 * - wide=true：使用较宽的 max-w-5xl；
 * - wide=false：使用普通的 max-w-4xl。
 */
const contentWidthClass = showSidebar
	? "max-w-[var(--page-width)]"
	: wide
		? "max-w-5xl"
		: "max-w-4xl";
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
>
	<!-- Navbar -->
	<slot slot="head" name="head"></slot>

	<div
		id="top-row"
		class:list={[
			"pointer-events-none relative z-50 mx-auto transition-all duration-700",
			contentWidthClass,
			"px-0 md:px-4",
		]}
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto sticky top-0 transition-all"
		>
			<Navbar></Navbar>
		</div>
	</div>

	<!-- Banner -->
	{
		siteConfig.banner.enable && (
			<div
				id="banner-wrapper"
				class="absolute z-10 w-full overflow-hidden transition duration-700"
				style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
			>
				<ImageWrapper
					id="banner"
					alt="Banner image of the blog"
					class:list={[
						"object-cover h-full transition duration-700 opacity-0 scale-105",
					]}
					src={siteConfig.banner.src}
					position={siteConfig.banner.position}
				>
				</ImageWrapper>
			</div>
		)
	}

	<!-- Main content -->
	<div
		class="pointer-events-none absolute z-30 w-full"
		style={`top: ${mainPanelTop}`}
	>
		<div
			class:list={[
				"pointer-events-auto relative mx-auto min-w-0",
				contentWidthClass,
			]}
		>
			<div id="swup-container" class="transition-swup-fade">
				<div
					id="main-grid"
					class:list={[
						"mx-auto grid w-full min-w-0 gap-4 px-0 transition duration-700 md:px-4",
						showSidebar
							? "grid-cols-1 lg:grid-cols-[17.5rem_minmax(0,1fr)]"
							: "grid-cols-1",
					]}
				>
					<!-- Sidebar -->
					{
						showSidebar && (
							<div
								id="sidebar-container"
								class="onload-animation mb-4 min-w-0 lg:max-w-[17.5rem]"
							>
								<SideBar headings={headings}></SideBar>
							</div>
						)
					}

					<!-- Main content -->
					<main
						id="swup-main"
						class:list={[
							"onload-animation min-w-0 max-w-full overflow-hidden",
							showSidebar
								? "lg:col-span-1"
								: "col-span-1",
						]}
					>
						<div id="content-wrapper" class="min-w-0 max-w-full">
							<slot></slot>

							<!-- Desktop footer -->
							<div class="footer onload-animation hidden lg:block">
								<Footer></Footer>
							</div>
						</div>
					</main>

					<!-- Mobile footer -->
					<div class="footer onload-animation block lg:hidden">
						<Footer></Footer>
					</div>
				</div>
			</div>

			<BackToTop></BackToTop>
		</div>
	</div>

	<!-- TOC -->
	<div class="absolute z-0 hidden w-full 2xl:block">
		<div class:list={["relative mx-auto", contentWidthClass]}>
			{
				siteConfig.toc.enable && (
					<div
						id="toc-wrapper"
						class:list={[
							"hidden items-center transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] lg:block",
							{ "toc-hide": siteConfig.banner.enable },
						]}
					>
						<div
							id="toc-inner-wrapper"
							class="fixed top-14 h-[calc(100vh_-_20rem)] w-[var(--toc-width)] overflow-x-hidden overflow-y-scroll hide-scrollbar"
						>
							<div
								id="toc"
								class="h-full w-full transition-swup-fade"
							>
								<div class="h-8 w-full"></div>
								<TOC headings={headings}></TOC>
								<div class="h-8 w-full"></div>
							</div>
						</div>
					</div>
				)
			}

			{!siteConfig.toc.enable && <div id="toc"></div>}
		</div>
	</div>
</Layout>
